# адрес сайта (после TLS — https, для проверки — http://IP)
SITE_URL=http://localhost

# vite в dev
FRONTEND_URL=http://localhost:5173

# mongo (в docker compose сервис mongo)
MONGODB_URI=mongodb://mongo:27017/onesec

# секреты jwt — любые длинные строки
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long

# true если сайт на https (куки)
COOKIE_SECURE=false

# секрет вебхука оплаты
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# раскомментируй, если нужен сид при старте (сотрёт данные)
# RUN_SEED=true
